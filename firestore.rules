rules_version = '2';

// ACCESS CONTROL
// Rules enforce, per request:
//   - authentication and an active staff profile,
//   - BRANCH ISOLATION: branch-scoped docs may only be read or written when their
//     branchId (missing = 'main', legacy data) is in the caller's profile.branchIds,
//     or the caller has profile.allBranches == true,
//   - append-only collections (ledger, stock movements, result versions, deliveries),
//   - the editable PERMISSION MATRIX for money-sensitive and admin writes. hasPerm / permAny
//     mirror effectivePermissions() in src/auth/permissions.ts:
//         labAdmin: everything.  Others: (role doc permissions OR user.grants) minus user.denies.
//         No role doc: the built-in defaults (roleDefaults below, kept in step with
//         DEFAULT_ROLE_PERMISSIONS; scripts/rules-check.mjs fails if they drift).
//         A role doc saved before the "__v2" marker gets the IMPLIED_BY keys added (impliedKeys below).
//   Per request this costs two extra document reads at most: the caller's profile (already read
//   by isStaff) and the caller's role document (read once, whichever number of keys are checked).
// What rules cannot check (price vs catalogue, totals vs lines beyond the first MAX lines,
// the max-discount % cap and approver) stays in the client; see the notes next to each rule.

service cloud.firestore {
  match /databases/{database}/documents {

    // Single-organisation deployment: every document lives under this one lab (VITE_LAB_ID, default 'main').
    // Collection-group queries (ledger by payment date) cannot bind the lab from the path, so it is fixed here.
    function lab() {
      return 'main';
    }
    function profile(labId) {
      return get(/databases/$(database)/documents/labs/$(labId)/users/$(request.auth.uid)).data;
    }
    // Staff = an active profile whose role is NOT one of the external partner portal roles.
    // (Rules cap evaluation at 1000 expressions per request, so the profile is read once via let.)
    function isStaff(labId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/labs/$(labId)/users/$(request.auth.uid))
        && staffProfile(profile(labId));
    }
    function staffProfile(p) {
      return p.active == true && !(p.role in ['b2b', 'collectionCentre', 'corporate', 'referrer']);
    }

    // ---- Partner portal (external roles) -----------------------------------------------
    // A portal user's profile carries role b2b | collectionCentre | corporate | referrer and a
    // partnerId (the partner document). They see only documents linked to that partner and can
    // create bills only for their own partner (b2b / collectionCentre / corporate).
    function partnerProfile(p) {
      return p.active == true && p.role in ['b2b', 'collectionCentre', 'corporate', 'referrer']
        && p.get('partnerId', '') != '';
    }
    function isPartner(labId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/labs/$(labId)/users/$(request.auth.uid))
        && partnerProfile(profile(labId));
    }
    // Does this order / document link to the caller's partner? (data = resource.data or request.resource.data)
    function partnerOwns(labId, data) {
      return request.auth != null && partnerOwnsP(profile(labId), data);
    }
    function partnerOwnsP(p, data) {
      return partnerProfile(p) && (
        (p.role == 'b2b' && data.get('b2bCentreId', '') == p.partnerId)
        || (p.role == 'collectionCentre' && data.get('collectionCentreId', '') == p.partnerId)
        || (p.role == 'corporate' && data.get('corporateClientId', '') == p.partnerId)
        || (p.role == 'referrer' && (data.get('referrerId', '') == p.partnerId
              || data.get('hospitalId', '') == p.partnerId)));
    }
    function partnerOrderOk(labId, orderId) {
      return partnerOwns(labId, get(/databases/$(database)/documents/labs/$(labId)/orders/$(orderId)).data);
    }
    function staffOrPartner(labId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/labs/$(labId)/users/$(request.auth.uid))
        && (staffProfile(profile(labId)) || partnerProfile(profile(labId)));
    }
    // Which master collection holds the caller's own partner document.
    function partnerCollectionOf(p) {
      return p.role == 'b2b' ? 'b2bCentres'
        : p.role == 'collectionCentre' ? 'collectionCentres'
        : p.role == 'corporate' ? 'corporateClients' : 'referrers';
    }
    function partnerDocOf(labId, p) {
      return get(/databases/$(database)/documents/labs/$(labId)/$(partnerCollectionOf(p))/$(p.partnerId)).data;
    }
    // May the caller's partner raise new bills? Active partner, and for B2B the booking lock is off.
    function partnerMayBill(labId) {
      return request.auth != null && partnerMayBillP(labId, profile(labId));
    }
    function partnerMayBillP(labId, p) {
      return partnerProfile(p) && p.role in ['b2b', 'collectionCentre', 'corporate']
        && partnerDocOf(labId, p).get('active', true) == true
        && (p.role != 'b2b' || partnerDocOf(labId, p).get('settings', {}).get('bookingLock', false) != true);
    }
    // Rule-evaluation budget helpers: one profile read per decision.
    function partnerBranchOk(p, data) {
      return 'branchId' in data && (p.get('allBranches', false) == true || data.branchId in p.get('branchIds', ['main']));
    }

    function hasRole(labId, roles) {
      return isStaff(labId) && profile(labId).role in roles;
    }
    function isAdmin(labId) {
      return hasRole(labId, ['labAdmin', 'admin']);
    }


    // ---- Permission matrix (mirror of src/auth/permissions.ts) ------------------------------
    // Built-in defaults, used only when labs/{lab}/roles/{role} does not exist. They carry the
    // "__v2" marker in the app, so no implied keys are added for them. Only keys that rules
    // check are listed. 'admin' holds everything by default.
    function roleDefaults(role) {
      return role == 'admin' ? ['bookings.manage', 'registration.create', 'quotation.manage', 'payment.collect', 'billing.discount', 'billing.clearDue', 'billing.refund', 'billing.edit', 'billing.void', 'billing.reverse', 'billing.backdate', 'results.enter', 'results.approve', 'results.unapprove', 'results.amend', 'catalogue.edit', 'catalogue.price', 'catalogue.delete', 'catalogue.import', 'referrals.manage', 'marketing.manage', 'b2b.view', 'b2b.manage', 'centres.manage', 'corporate.manage', 'ratelists.edit', 'outsource.view', 'outsource.edit', 'labmgmt.manage', 'qc.setup', 'ai.interpret', 'settings.manage', 'labprofile.edit', 'users.manage', 'roles.manage', 'branches.manage', '__v2']
        : role == 'manager' ? ['bookings.manage', 'registration.create', 'quotation.manage', 'payment.collect', 'billing.discount', 'billing.clearDue', 'billing.refund', 'billing.edit', 'billing.void', 'billing.reverse', 'billing.backdate', 'catalogue.edit', 'catalogue.price', 'catalogue.delete', 'catalogue.import', 'referrals.manage', 'marketing.manage', 'b2b.view', 'b2b.manage', 'centres.manage', 'corporate.manage', 'ratelists.edit', 'outsource.view', 'outsource.edit', 'labmgmt.manage', 'qc.setup', 'results.enter', '__v2']
        : role == 'reception' ? ['bookings.manage', 'registration.create', 'quotation.manage', 'billing.discount', 'billing.clearDue', 'payment.collect', '__v2']
        : role == 'technician' ? ['results.enter', 'outsource.view', '__v2']
        : role == 'doctor' ? ['results.enter', 'results.approve', 'results.unapprove', 'results.amend', 'qc.setup', 'ai.interpret', '__v2']
        : ['__v2'];
    }
    // Keys implied by an older key, for role docs saved before the "__v2" marker (IMPLIED_BY).
    function impliedKeys(rp) {
      return (('settings.manage' in rp) ? ['labprofile.edit', 'referrals.manage', 'labmgmt.manage'] : [])
        .concat(('billing.void' in rp) ? ['billing.reverse'] : [])
        .concat(('billing.edit' in rp) ? ['billing.backdate'] : [])
        .concat(('registration.create' in rp) ? ['payment.collect', 'quotation.manage'] : [])
        .concat(('catalogue.edit' in rp) ? ['ratelists.edit', 'outsource.edit', 'catalogue.delete', 'catalogue.import'] : [])
        .concat(('catalogue.view' in rp) ? ['outsource.view'] : [])
        .concat(('finance.view' in rp) ? ['b2b.view', 'b2b.manage', 'centres.manage', 'corporate.manage'] : [])
        .concat(('users.manage' in rp) ? ['marketing.manage'] : [])
        .concat(('bookings.create' in rp) ? ['bookings.manage'] : []);
    }
    // The role document is read once per request (exists + get hit the same cached document).
    function roleList(labId, role) {
      let path = /databases/$(database)/documents/labs/$(labId)/roles/$(role);
      return exists(path) && 'permissions' in get(path).data ? get(path).data.permissions : roleDefaults(role);
    }
    // Rules are limited to 1000 expressions per request, so permission tests are kept small:
    // permAny(keys) = caller holds ANY of keys; heldOf(keys) = the keys (of a longer list) the caller holds,
    // worked out once so one rule can test several keys cheaply.
    function permCheck(labId, p, keys) {
      let rp = roleList(labId, p.role);
      let live = keys.removeAll(p.get('denies', []));
      return rp.hasAny(live)
        || p.get('grants', []).hasAny(live)
        || (!('__v2' in rp) && impliedKeys(rp).hasAny(live));
    }
    // True when the caller (active staff) holds ANY of the keys. labAdmin holds every key.
    function permAny(labId, keys) {
      let p = profile(labId);
      return staffProfile(p) && (p.role == 'labAdmin' || permCheck(labId, p, keys));
    }
    function hasPerm(labId, key) {
      return permAny(labId, [key]);
    }
    function heldOf(labId, keys) {
      let p = profile(labId);
      let rp = roleList(labId, p.role);
      let eff = ('__v2' in rp ? rp : rp.concat(impliedKeys(rp))).concat(p.get('grants', [])).removeAll(p.get('denies', []));
      return !staffProfile(p) ? [] : p.role == 'labAdmin' ? keys : keys.removeAll(keys.removeAll(eff));
    }
    // Fields that differ between the stored document and the incoming write (update only).
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    // Start of today in India time (UTC+5:30), in milliseconds: "back-dated" means before this.
    function istDayStartMs() {
      return math.floor((request.time.toMillis() + 19800000) / 86400000.0) * 86400000 - 19800000;
    }

    // ---- Branch isolation -------------------------------------------------------
    // Legacy profiles without branchIds are treated as ['main'].
    function userBranches(labId) {
      return profile(labId).get('branchIds', ['main']);
    }
    function canUseBranch(labId, branchId) {
      return profile(labId).get('allBranches', false) == true || branchId in userBranches(labId);
    }
    // Branch of an existing document; docs created before branches existed are 'main'.
    function docBranch(data) {
      return data.get('branchId', 'main');
    }
    function readBranch(labId) {
      return isStaff(labId) && canUseBranch(labId, docBranch(resource.data));
    }
    // Create: branchId must be present and permitted.
    function createBranch(labId) {
      return isStaff(labId) && 'branchId' in request.resource.data
        && canUseBranch(labId, request.resource.data.branchId);
    }
    // Update: caller may use the existing branch and may not move the doc to another one
    // (stamping legacy docs with 'main' is allowed: docBranch() already treats them as main).
    function updateBranch(labId) {
      return isStaff(labId) && canUseBranch(labId, docBranch(resource.data))
        && docBranch(request.resource.data) == docBranch(resource.data);
    }
    // Branch of a parent order (for ledger / results / deliveries sub-collections).
    function orderBranchOk(labId, orderId) {
      return isStaff(labId)
        && canUseBranch(labId, docBranch(get(/databases/$(database)/documents/labs/$(labId)/orders/$(orderId)).data));
    }

    // ---- Bills (orders): which writes need which permission ------------------------------------
    // Rules cannot loop and are limited to 1000 expressions per request, so the per-line checks look at the first
    // 10 lines of a bill (index 0..9); a bill with more lines is only protected on those lines plus the
    // add / remove (size) check.
    // lineMoney: line i keeps its price and discount (a bill shorter than i + 1 lines always passes).
    function lineMoney(ni, oi, i) {
      return ni.size() <= i
        || (ni[i].get('price', 0) == oi[i].get('price', 0) && ni[i].get('discount', 0) == oi[i].get('discount', 0));
    }
    function linePrice(ni, oi, i) {
      return ni.size() <= i || ni[i].get('price', 0) == oi[i].get('price', 0);
    }
    function linesMoneyKept(ni, oi) {
      return lineMoney(ni, oi, 0)
        && lineMoney(ni, oi, 1)
        && lineMoney(ni, oi, 2)
        && lineMoney(ni, oi, 3)
        && lineMoney(ni, oi, 4)
        && lineMoney(ni, oi, 5)
        && lineMoney(ni, oi, 6)
        && lineMoney(ni, oi, 7)
        && lineMoney(ni, oi, 8)
        && lineMoney(ni, oi, 9);
    }
    function linesPriceKept(ni, oi) {
      return linePrice(ni, oi, 0)
        && linePrice(ni, oi, 1)
        && linePrice(ni, oi, 2)
        && linePrice(ni, oi, 3)
        && linePrice(ni, oi, 4)
        && linePrice(ni, oi, 5)
        && linePrice(ni, oi, 6)
        && linePrice(ni, oi, 7)
        && linePrice(ni, oi, 8)
        && linePrice(ni, oi, 9);
    }
    // Lines of a new bill carry no discount.
    function lineNoDiscount(ni, i) {
      return ni.size() <= i || ni[i].get('discount', 0) == 0;
    }
    function linesNoDiscount(ni) {
      return lineNoDiscount(ni, 0)
        && lineNoDiscount(ni, 1)
        && lineNoDiscount(ni, 2)
        && lineNoDiscount(ni, 3)
        && lineNoDiscount(ni, 4)
        && lineNoDiscount(ni, 5)
        && lineNoDiscount(ni, 6)
        && lineNoDiscount(ni, 7)
        && lineNoDiscount(ni, 8)
        && lineNoDiscount(ni, 9);
    }
    // Keys that post to the ledger: they may move a bill's paid / due / refunded.
    function billMoneyPerms() {
      return ['payment.collect', 'billing.clearDue', 'billing.refund', 'billing.reverse', 'billing.void', 'billing.edit', 'billing.discount'];
    }
    // Order fields whose change needs a key. A write touching none of them (accession, results status,
    // dispatch, print marks) only has to keep every checked line's price, discount and refund state.
    function orderGuardedKeys() {
      return ['deleted', 'voidRefundPending', 'refundPendingApproval', 'revisions', 'rev', 'writeOffs', 'gross', 'discount', 'net',
        'paid', 'due', 'refunded', 'billDate',
        'referrerId', 'referrerName', 'hospitalId', 'hospitalName', 'secondReferrerId', 'secondReferrerName',
        'b2bCentreId', 'b2bCentreName', 'collectionCentreId', 'collectionCentreName', 'corporateClientId', 'corporateClientName',
        'govPanelId', 'govPanelName', 'tpaId', 'tpaName', 'payer', 'billedTo', 'discountReason', 'discountedBy',
        'discountBearer', 'discountSplitReferrerPct', 'commissionSnapshot', 'proId', 'proName', 'pcpndt'];
    }
    // A bill converted from a booking carries the booking's own discount and prepayment.
    function bookingCovers(n, field, amount) {
      return n.get('bookingId', '') != ''
        && get(/databases/$(database)/documents/labs/main/bookings/$(n.bookingId)).data.get(field, 0) >= amount;
    }

    // New bill by staff: no discount without billing.discount, no back-dating without billing.backdate,
    // no money already on it without payment.collect (a B2B wallet bill or a booking prepayment carries paid > 0).
    function orderCreateOk(labId) {
      let n = request.resource.data;
      return n.get('deleted', false) == false
        && n.get('refunded', 0) == 0
        && ((n.get('discount', 0) == 0 && linesNoDiscount(n.get('items', [])))
            || permAny(labId, ['billing.discount'])
            || bookingCovers(n, 'discount', n.get('discount', 0)))
        && (!('billDate' in n) || n.billDate.toMillis() >= istDayStartMs() || permAny(labId, ['billing.backdate']))
        && (n.get('paid', 0) == 0
            || n.get('billedTo', '') == 'b2b'
            || permAny(labId, ['payment.collect'])
            || bookingCovers(n, 'prepaid', n.get('paid', 0)));
    }

    // Update of an existing bill.
    function orderUpdateOk(labId) {
      let a = changed();
      return a.hasAny(orderGuardedKeys())
        ? orderGuardedUpdateOk(labId, a)
        : (!a.hasAny(['items']) || orderItemsOk(labId));
    }
    // Only the lines changed (no guarded field): status-like changes are open; a moved price / discount or an
    // added / removed line is edit-bill.
    function orderItemsOk(labId) {
      let ni = request.resource.data.get('items', []);
      let oi = resource.data.get('items', []);
      return (ni.size() == oi.size() && linesMoneyKept(ni, oi)) || permAny(labId, ['billing.edit']);
    }
    function orderGuardedUpdateOk(labId, a) {
      let n = request.resource.data;
      let o = resource.data;
      let held = heldOf(labId, ['billing.void', 'billing.refund', 'billing.edit', 'billing.discount', 'billing.reverse', 'billing.clearDue', 'payment.collect', 'billing.backdate', 'referrals.manage']);
      return
        // edit-bill (revision trail, optimistic-lock counter, partner / referrer / totals / lines): billing.edit
        // covers everything except voiding, refund markers and back-dating
        (held.hasAny(['billing.edit']) && !a.hasAny(['deleted', 'voidRefundPending', 'refundPendingApproval', 'billDate']))
        // write-off of a due balance: exactly the fields writeOffDue sets, prices untouched
        || (a.hasAny(['writeOffs']) && a.hasOnly(['items', 'gross', 'discount', 'net', 'writeOffs', 'revisions'])
            && held.hasAny(['billing.discount'])
            && (!a.hasAny(['items']) || (n.get('items', []).size() == o.get('items', []).size() && linesPriceKept(n.get('items', []), o.get('items', [])))))
        // everything else: the clauses below, one per guarded pattern
        || (!a.hasAny(['revisions', 'rev', 'writeOffs'])
            // void (deleted false -> true) and its leftovers
            && (!a.hasAny(['deleted']) || held.hasAny(['billing.void']))
            && (!a.hasAny(['voidRefundPending']) || held.hasAny(['billing.refund', 'billing.void']))
            // refund request / approval marker
            && (!a.hasAny(['refundPendingApproval']) || held.hasAny(['billing.refund']))
            // referrer / partner / payer / discount-reason fields (billing.edit is the fast path above)
            && (!a.hasAny(['referrerId', 'referrerName', 'hospitalId', 'hospitalName', 'secondReferrerId', 'secondReferrerName',
                  'b2bCentreId', 'b2bCentreName', 'collectionCentreId', 'collectionCentreName', 'corporateClientId', 'corporateClientName',
                  'govPanelId', 'govPanelName', 'tpaId', 'tpaName', 'payer', 'billedTo', 'discountReason', 'discountedBy',
                  'discountBearer', 'discountSplitReferrerPct', 'commissionSnapshot', 'proId', 'proName', 'pcpndt'])
                || held.hasAny(['referrals.manage']))
            // lines: a moved price / discount or a size change needs edit-bill (the fast path above)
            && (!a.hasAny(['items']) || (n.get('items', []).size() == o.get('items', []).size() && linesMoneyKept(n.get('items', []), o.get('items', []))))
            // header totals only go down, and only through a refund
            && (!a.hasAny(['gross', 'discount', 'net'])
                || (n.get('gross', 0) <= o.get('gross', 0) && n.get('discount', 0) <= o.get('discount', 0)
                    && held.hasAny(['billing.refund'])))
            // paid / due / refunded are derived from the ledger: only a key that posts to the ledger may move them
            && (!a.hasAny(['paid', 'due', 'refunded']) || held.hasAny(billMoneyPerms()))
            // bill date
            && (!a.hasAny(['billDate']) || !('billDate' in n) || n.billDate.toMillis() >= istDayStartMs()
                || held.hasAny(['billing.backdate'])));
    }
    // ---- Ledger (append-only money trail) ----------------------------------------------------
    function ledgerCreateOk(labId, orderId) {
      let n = request.resource.data;
      let order = get(/databases/$(database)/documents/labs/$(labId)/orders/$(orderId)).data;
      let t = n.get('type', '');
      return n.get('postedAt', null) == request.time
        && n.get('postedBy', '') == request.auth.uid
        && (!('backdatedTo' in n) || permAny(labId, ['billing.backdate']))
        && (
          (t == 'payment' && n.get('amount', 0) > 0
            && (permAny(labId, ['payment.collect'])
                // staff billing a B2B centre post the wallet payment (and edit-bill tops it up)
                || (n.get('mode', '') == 'wallet' && order.get('billedTo', '') == 'b2b'
                    && permAny(labId, ['registration.create', 'billing.edit']))
                // prepayment taken on a booking and carried onto its bill
                || bookingCovers(order, 'prepaid', n.get('amount', 0))))
          || (t == 'clearDue' && n.get('amount', 0) > 0
              && heldOf(labId, ['billing.clearDue', 'payment.collect']).hasAll(['billing.clearDue', 'payment.collect']))
          || (t == 'refund' && n.get('amount', 0) < 0
              && (permAny(labId, ['billing.refund'])
                  // a void pays the bill back (the bill is already marked deleted)
                  || (order.get('deleted', false) == true && permAny(labId, ['billing.void']))
                  // edit-bill of a B2B bill gives the wallet difference back
                  || (n.get('mode', '') == 'wallet' && order.get('billedTo', '') == 'b2b'
                      && permAny(labId, ['billing.edit']))))
          || (t == 'reversal' && n.get('amount', 0) < 0 && permAny(labId, ['billing.reverse']))
        );
    }

    // ---- Results ----------------------------------------------------------------------------------
    // Saving / entering: results.enter. Status -> approved: results.approve. Approved -> not approved:
    // results.unapprove (or results.amend, as the app allows). Changing the content of an approved
    // result: results.amend.
    function resultCreateOk(labId) {
      return request.resource.data.get('status', 'pending') == 'approved'
        ? hasPerm(labId, 'results.approve')
        : hasPerm(labId, 'results.enter');
    }
    function resultUpdateOk(labId) {
      let was = resource.data.get('status', 'pending');
      let now = request.resource.data.get('status', 'pending');
      let a = changed();
      return (now == 'approved' && was != 'approved') ? permAny(labId, ['results.approve'])
        : (was == 'approved' && now != 'approved') ? permAny(labId, ['results.unapprove', 'results.amend'])
        : was == 'approved'
          ? (a.hasAny(['values', 'comment', 'paramComments', 'radiology', 'rejectedValues', 'rejectedParams'])
              ? permAny(labId, ['results.amend'])
              : permAny(labId, ['results.enter', 'results.approve', 'results.amend', 'ai.interpret']))
        : (a.size() > 0 && a.hasOnly(['aiInterpretation', 'updatedAt'])) ? permAny(labId, ['ai.interpret', 'results.enter'])
        : (a.size() > 0 && a.hasOnly(['status', 'verification', 'sentBack', 'updatedAt'])) ? permAny(labId, ['results.enter', 'results.approve'])
        : permAny(labId, ['results.enter']);
    }

    // Collection-group reads of ledger entries (Collection wise finance by payment date).
    // Entries carry branchId, so the same branch isolation applies.
    match /{path=**}/ledger/{entryId} {
      allow read: if isStaff(lab()) && canUseBranch(lab(), docBranch(resource.data));
    }

    // Collection-group read of entered results (guard against removing a parameter that already has values).
    // Catalogue editors only; results carry no branch so this stays admin / manager.
    match /{path=**}/results/{testId} {
      allow read: if hasRole(lab(), ['labAdmin', 'admin', 'manager']);
    }

    // Public report share links: Cloud Functions only (Admin SDK bypasses rules).
    match /reportShares/{token} {
      allow read, write: if false;
    }

    // MCP connector token lookup (sha256(token) -> lab): Cloud Functions only.
    match /mcpTokens/{hash} {
      allow read, write: if false;
    }

    // Lab document (settings and lab profile). settings.manage may change anything; labprofile.edit only the
    // profile fields (details, report and bill layout, doctors, templates...); a few keys have their own owner.
    // 'subscription' is written by the platform (Admin SDK) only.
    function labProfileKeys() {
      return ['name', 'address', 'phone', 'email', 'billPrefix', 'profile', 'dailyReport', 'reportDetails', 'billDetails',
        'quotation', 'signatories', 'b2bInvoice', 'corporateInvoice', 'docTemplates', 'templates', 'extraTemplates',
        'reportLayout', 'radiologyConfig', 'pcpndt', 'emailSender', 'branchOverrides', 'credent', 'commentTemplates',
        'publicAppUrl', 'reportLinkDays', 'smartReport'];
    }
    function labUpdateOk(labId) {
      let a = changed();
      return !a.hasAny(['subscription'])
        && (permAny(labId, ['settings.manage'])
            || (a.size() > 0 && a.hasOnly(labProfileKeys()) && permAny(labId, ['labprofile.edit']))
            || (a.size() > 0 && a.hasOnly(['qcSettings']) && permAny(labId, ['qc.setup']))
            || (a.size() > 0 && a.hasOnly(['quotation']) && permAny(labId, ['quotation.manage']))
            || (a.size() > 0 && a.hasOnly(['commentTemplates']) && permAny(labId, ['catalogue.edit'])));
    }
    match /labs/{labId} {
      allow read: if staffOrPartner(labId);
      allow create: if permAny(labId, ['settings.manage']);
      allow update: if labUpdateOk(labId);
      allow delete: if false;

      // Staff profiles: everyone reads (names on reports), only admins manage.
      match /users/{uid} {
        allow read: if isStaff(labId) || request.auth.uid == uid;
        allow create, update, delete: if hasPerm(labId, 'users.manage');
        // Staff may edit their own profile basics and stamp their sign-in time,
        // never their role, permissions or branches.
        allow update: if request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['name', 'phone', 'signature', 'lastLoginAt']);

        // Active login sessions (login-limit enforcement). A user manages their own
        // session docs; admins may list and remove them (force logout).
        match /sessions/{sid} {
          allow read: if request.auth.uid == uid || permAny(labId, ['users.manage']);
          allow create, update: if request.auth.uid == uid && isStaff(labId);
          allow delete: if request.auth.uid == uid || permAny(labId, ['users.manage']);
        }
      }

      // Round 3: lab-side requests and device codes.
      // Delete-account requests: the user files one for themselves, admins approve or reject (never delete).
      match /accountRequests/{id} {
        allow read: if isAdmin(labId) || (request.auth != null && resource.data.uid == request.auth.uid);
        allow create: if isStaff(labId) && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'pending';
        allow update: if isAdmin(labId);
        allow delete: if false;
      }
      // Browser (device) codes shown on the profile: the user registers their own, admins approve or revoke.
      match /browserCodes/{id} {
        allow read: if isAdmin(labId) || (request.auth != null && resource.data.uid == request.auth.uid);
        allow create: if isStaff(labId) && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'pending';
        allow update: if isAdmin(labId) || (request.auth != null && resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeenAt', 'label']));
        allow delete: if false;
      }

      // Round 3 shell: usage tracking, announcements, surveys, idea votes/comments.
      // Page-view counters: a user writes only their own doc (id = YYYY-MM-DD_uid); admins read all.
      match /usage/{usageId} {
        allow read: if isAdmin(labId) || (request.auth != null && usageId.matches('.*_' + request.auth.uid));
        allow create, update: if isStaff(labId) && usageId.matches('.*_' + request.auth.uid)
          && request.resource.data.uid == request.auth.uid;
        allow delete: if false;
      }
      match /announcements/{id} {
        allow read: if isStaff(labId);
        allow write: if isAdmin(labId);
      }
      match /surveys/{sid} {
        allow read: if isStaff(labId);
        allow write: if isAdmin(labId);
        match /votes/{uid} {
          allow read: if isStaff(labId);
          allow create, update: if isStaff(labId) && request.auth.uid == uid
            && get(/databases/$(database)/documents/labs/$(labId)/surveys/$(sid)).data.status == 'open';
          allow delete: if isAdmin(labId);
        }
        match /comments/{cid} {
          allow read: if isStaff(labId);
          allow create: if isStaff(labId) && request.resource.data.by == request.auth.uid;
          allow delete: if isAdmin(labId) || (isStaff(labId) && resource.data.by == request.auth.uid);
        }
      }
      match /supportTickets/{tid}/votes/{uid} {
        allow read: if isStaff(labId);
        allow create, update: if isStaff(labId) && request.auth.uid == uid;
        allow delete: if isStaff(labId) && request.auth.uid == uid;
      }
      match /supportTickets/{tid}/comments/{cid} {
        allow read: if isStaff(labId);
        allow create: if isStaff(labId) && request.resource.data.by == request.auth.uid;
        allow delete: if isAdmin(labId) || (isStaff(labId) && resource.data.by == request.auth.uid);
      }

      // Editable permission matrix and branches: everyone reads, admins write.
      match /roles/{roleId} {
        allow read: if staffOrPartner(labId);
        allow write: if hasPerm(labId, 'roles.manage');
      }
      match /branches/{branchId} {
        allow read: if staffOrPartner(labId);
        allow write: if hasPerm(labId, 'branches.manage');
      }

      // Catalogue: read by all staff. Create / edit: catalogue.edit (or catalogue.import for the bulk upload).
      // A price change needs catalogue.price (or import). Delete, soft-delete and restore need catalogue.delete.
      // Outsource mapping on a test (outsourceLabs) is also open to outsource.edit.
      // Not enforceable here: that a bill line's price matches the catalogue / rate list.
      function catalogueUpdateOk(labId) {
        let a = changed();
        return (a.size() > 0 && a.hasOnly(['deleted', 'deletedAt']))
          ? permAny(labId, ['catalogue.delete', 'settings.manage'])
          : (a.size() > 0 && a.hasOnly(['price', 'updatedAt']))
            ? permAny(labId, ['catalogue.price', 'catalogue.import'])
            : (a.size() > 0 && a.hasOnly(['outsourceLabs', 'updatedAt']))
              ? permAny(labId, ['catalogue.edit', 'catalogue.import', 'outsource.edit'])
              : permAny(labId, ['catalogue.edit', 'catalogue.import'])
                && (!a.hasAny(['deleted', 'deletedAt']) || permAny(labId, ['catalogue.delete', 'settings.manage']))
                && (!a.hasAny(['price']) || permAny(labId, ['catalogue.price', 'catalogue.import']));
      }
      match /{catalogue}/{id} {
        allow read: if catalogue in ['departments', 'sampleTypes', 'tests', 'packages']
          && staffOrPartner(labId);
        allow create: if catalogue in ['departments', 'sampleTypes', 'tests', 'packages']
          && permAny(labId, ['catalogue.edit', 'catalogue.import']);
        allow update: if catalogue in ['departments', 'sampleTypes', 'tests', 'packages']
          && catalogueUpdateOk(labId);
        allow delete: if catalogue in ['departments', 'sampleTypes', 'tests', 'packages']
          && permAny(labId, ['catalogue.delete']);
      }

      match /counters/{name} {
        allow read, write: if isStaff(labId);
        // Portal billing takes the next patient / bill / barcode number.
        allow read, write: if partnerMayBill(labId) && name.matches('(patient-.*|bill|barcode.*|uhid|receipt-.*)');
      }

      // Home-collection bookings: front desk and phlebotomists.
      match /bookings/{id} {
        allow read: if hasRole(labId, ['labAdmin', 'admin', 'manager', 'reception', 'phlebotomist']) && readBranch(labId);
        allow create: if hasRole(labId, ['labAdmin', 'admin', 'manager', 'reception', 'phlebotomist']) && createBranch(labId);
        allow update: if hasRole(labId, ['labAdmin', 'admin', 'manager', 'reception', 'phlebotomist']) && updateBranch(labId);
        allow delete: if false;

        // Note attachments: small data-URL documents.
        match /attachments/{attId} {
          allow read, create, delete: if hasRole(labId, ['labAdmin', 'admin', 'manager', 'reception', 'phlebotomist']);
          allow update: if false;
        }
      }

      // Written only by Cloud Functions (Admin SDK bypasses rules).
      match /outbox/{id} {
        allow read: if isAdmin(labId);
        allow write: if false;
      }

      // AI: chats are private to their author; dashboards are shared with AI users.
      // Writes go through Cloud Functions (Admin SDK), except renames/deletes below.
      match /aiChats/{id} {
        allow read: if hasRole(labId, ['labAdmin', 'admin', 'manager'])
          && resource.data.userId == request.auth.uid;
        allow update: if hasRole(labId, ['labAdmin', 'admin', 'manager'])
          && resource.data.userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title']);
        allow delete: if hasRole(labId, ['labAdmin', 'admin', 'manager'])
          && resource.data.userId == request.auth.uid;
        allow create: if false;
        // Streamed answer of the turn in progress: only the server writes it; the chat owner reads it
        // and may set the cancel flag (nothing else).
        match /stream/{sid} {
          // resource == null: listening before the server has created the doc (a brand-new chat).
          allow read: if hasRole(labId, ['labAdmin', 'admin', 'manager'])
            && (resource == null || resource.data.userId == request.auth.uid);
          allow update: if hasRole(labId, ['labAdmin', 'admin', 'manager'])
            && resource.data.userId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cancel']);
          allow create, delete: if false;
        }
        match /{rest=**} {
          allow read, write: if false; // full API transcripts stay server-side
        }
      }
      // Dashboards: the owner and lab admins read and edit them here (sharing included). Everyone else
      // lists and opens the ones shared with their role through the listAiDashboards callable.
      match /aiDashboards/{id} {
        allow read, update, delete: if hasRole(labId, ['labAdmin', 'admin', 'manager'])
          && (isAdmin(labId) || resource.data.createdBy == request.auth.uid);
        allow create: if false;
      }
      // Pinned AI tables (with their added columns): one doc per user, private to them.
      match /aiTablePins/{uid} {
        allow read, write: if hasRole(labId, ['labAdmin', 'admin', 'manager'])
          && uid == request.auth.uid;
      }
      match /mcpConnections/{id} {
        allow read: if isAdmin(labId);
        allow write: if false;
      }
      match /mcpAudit/{id} {
        allow read: if isAdmin(labId);
        allow write: if false;
      }

      // Quality control and NABL records: technicians, doctors and managers.
      // qcMaterials are shared by all branches; the rest are branch-scoped.
      match /qcMaterials/{id} {
        allow read: if isStaff(labId);
        allow create, update: if hasRole(labId, ['labAdmin', 'admin', 'manager', 'technician', 'doctor']);
        allow delete: if isAdmin(labId);
      }
      // Collection-centre dispatch manifests (sample batches in transit): staff, branch-scoped, never deleted.
      match /manifests/{id} {
        allow read: if readBranch(labId);
        // A collection-centre portal login sees the manifests of its own centre (created by the portalDispatchManifest function).
        allow read: if isPartner(labId) && profile(labId).role == 'collectionCentre' && resource.data.get('centreId', '') == profile(labId).partnerId;
        allow create: if createBranch(labId);
        allow update: if updateBranch(labId);
        allow delete: if false;
      }
      // Online payments (Razorpay orders and what they were posted as): written by Cloud Functions only.
      match /payments/{id} {
        allow read: if hasRole(labId, ['labAdmin', 'admin', 'manager']);
        allow write: if false;
      }
      // Credit wallet and its ledger: written by Cloud Functions only (credit purchase through the gateway).
      match /aiCredits/{id} {
        allow read: if hasRole(labId, ['labAdmin', 'admin', 'manager']);
        allow write: if false;
      }
      match /aiCreditLedger/{id} {
        allow read: if hasRole(labId, ['labAdmin', 'admin', 'manager']);
        allow write: if false;
      }
      // Bulk registration job: per-chunk row results written by the runBulkRegistration function.
      match /bulkImports/{importId}/results/{chunk} {
        allow read: if isStaff(labId);
        allow write: if false;
      }
      // Short-lived "someone is editing this bill's results" marker, one doc per bill (expires by timestamp).
      match /resultLocks/{orderId} {
        allow read, write: if isStaff(labId);
      }
      // Analyser results that matched no bill or test (written by the analyserIngest function; staff may clear them).
      match /analyserUnmatched/{id} {
        allow read: if readBranch(labId);
        allow update, delete: if updateBranch(labId);
        allow create: if false;
      }
      // IQC sheet print log: append-only, branch-scoped.
      match /iqcDownloads/{id} {
        allow read: if readBranch(labId);
        allow create: if hasRole(labId, ['labAdmin', 'admin', 'manager', 'technician', 'doctor']) && createBranch(labId);
        allow update, delete: if false;
      }
      // Mass statement jobs: staff request, the server (Cloud Function) builds and updates them;
      // a failed job may be re-queued by the requester.
      match /statementJobs/{id} {
        allow read: if hasRole(labId, ['labAdmin', 'admin', 'manager']);
        allow create: if hasRole(labId, ['labAdmin', 'admin', 'manager'])
          && request.resource.data.status == 'queued' && request.resource.data.requestedBy == request.auth.uid;
        allow update: if hasRole(labId, ['labAdmin', 'admin', 'manager'])
          && resource.data.status == 'failed' && request.resource.data.status == 'queued'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'retryCount']);
        allow delete: if false;
        match /files/{fileId} {
          allow read: if hasRole(labId, ['labAdmin', 'admin', 'manager']);
          allow write: if false;
        }
      }
      // Append-only audit log: written by the mirrorActivityToAudit Cloud Function only, never edited or deleted.
      match /auditLog/{id} {
        allow read: if hasRole(labId, ['labAdmin', 'admin', 'manager']) && readBranch(labId);
        allow write: if false;
      }
      // NABL register column choices, shared by the whole lab (one doc per register).
      match /nablColumns/{id} {
        allow read: if isStaff(labId);
        allow write: if hasRole(labId, ['labAdmin', 'admin', 'manager', 'technician', 'doctor']);
      }
      // AI metering written by Cloud Functions only; admins read the monthly counters.
      match /aiUsage/{id} {
        allow read: if isAdmin(labId);
        allow write: if false;
      }
      match /{qc}/{id} {
        allow read: if qc in ['qcMachines', 'qcRuns', 'capas', 'eqasRounds', 'ilcStudies', 'validationStudies', 'sampleDiscards', 'qcOccurrences']
          && readBranch(labId);
        allow create: if qc in ['qcMachines', 'qcRuns', 'capas', 'eqasRounds', 'ilcStudies', 'validationStudies', 'sampleDiscards', 'qcOccurrences']
          && hasRole(labId, ['labAdmin', 'admin', 'manager', 'technician', 'doctor']) && createBranch(labId);
        allow update: if qc in ['qcMachines', 'qcRuns', 'capas', 'eqasRounds', 'ilcStudies', 'validationStudies', 'sampleDiscards', 'qcOccurrences']
          && hasRole(labId, ['labAdmin', 'admin', 'manager', 'technician', 'doctor']) && updateBranch(labId);
        // QC runs and discard records are part of the audit trail.
        allow delete: if qc in ['qcMachines', 'eqasRounds', 'ilcStudies', 'validationStudies']
          && isAdmin(labId) && canUseBranch(labId, docBranch(resource.data));
      }

      // Inventory: stock movements are append-only; batches change only via movements.
      // invItems / invSuppliers / stockMappings are shared by all branches;
      // invBatches, stockMovements and purchaseOrders are branch-scoped.
      match /{inv}/{id} {
        allow read: if inv in ['invItems', 'invSuppliers', 'stockMappings', 'invBatches', 'purchaseOrders']
          && hasRole(labId, ['labAdmin', 'admin', 'manager', 'technician'])
          && (inv in ['invItems', 'invSuppliers', 'stockMappings'] || (inv == 'purchaseOrders' && readBranch(labId)));
        allow create: if inv in ['invItems', 'invSuppliers', 'stockMappings', 'invBatches', 'purchaseOrders']
          && hasRole(labId, ['labAdmin', 'admin', 'manager', 'technician'])
          && (inv in ['invItems', 'invSuppliers', 'stockMappings'] || (inv in ['invBatches', 'purchaseOrders'] && createBranch(labId)));
        allow update: if inv in ['invItems', 'invSuppliers', 'stockMappings', 'invBatches', 'purchaseOrders']
          && hasRole(labId, ['labAdmin', 'admin', 'manager', 'technician'])
          && (inv in ['invItems', 'invSuppliers', 'stockMappings'] || (inv in ['invBatches', 'purchaseOrders'] && updateBranch(labId)));
        allow delete: if inv in ['invItems', 'invSuppliers', 'stockMappings'] && isAdmin(labId);
      }
      match /stockMovements/{id} {
        // Reception may read auto-consumption / return rows so a refund or void can restore stock.
        allow read: if readBranch(labId)
          && (hasRole(labId, ['labAdmin', 'admin', 'manager', 'technician'])
              || (isStaff(labId) && resource.data.type in ['consume_auto', 'return']));
        allow create: if createBranch(labId); // auto-consumption runs on sample receipt by any staff
        // Append-only. One exception: an admin may stamp a legacy movement (no branchId) as 'main'.
        allow update: if isAdmin(labId) && !('branchId' in resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['branchId'])
          && request.resource.data.branchId == 'main';
        allow delete: if false;
      }
      // Auto-consumption runs when any staff member (incl. reception) receives a
      // sample, so all staff may read lots and test mappings and decrement lots.
      match /invBatches/{id} {
        allow read: if readBranch(labId);
        allow update: if updateBranch(labId);
      }
      match /stockMappings/{id} {
        allow read: if isStaff(labId);
      }

      // Shared master data (all branches): referrers, partners, rate lists,
      // charges, payment modes, templates and reason lists.
      // Reception may quick-add a TEMPORARY referring doctor/hospital at registration
      // (create only, temporary == true); completing or editing it needs a manager.
      match /referrers/{id} {
        allow create: if hasRole(labId, ['reception', 'phlebotomist', 'technician'])
          && request.resource.data.get('temporary', false) == true;
      }

      // Partner portal: a portal user reads only their own partner document, that partner's rate
      // list, wallet rows, credit/debit notes and invoices.
      match /{pmaster}/{id} {
        allow read: if pmaster in ['b2bCentres', 'collectionCentres', 'corporateClients', 'referrers', 'rateLists', 'walletTxns', 'creditNotes', 'partnerInvoices', 'commissionSettlements'] && isPartner(labId) && pmaster == partnerCollectionOf(profile(labId)) && id == profile(labId).partnerId;
        allow read: if pmaster == 'rateLists' && isPartner(labId) && id == partnerDocOf(labId, profile(labId)).get('rateListId', '');
        allow read: if pmaster in ['walletTxns', 'creditNotes'] && isPartner(labId)
          && profile(labId).role == 'b2b' && resource.data.get('centreId', '') == profile(labId).partnerId;
        allow read: if pmaster == 'partnerInvoices' && isPartner(labId)
          && profile(labId).role in ['b2b', 'corporate'] && resource.data.get('partyId', '') == profile(labId).partnerId;
        // A referrer portal user reads the commission payouts (and reversals) recorded for their own referrer record.
        allow read: if pmaster == 'commissionSettlements' && isPartner(labId)
          && profile(labId).role == 'referrer'
          && resource.data.get('partnerKind', '') == 'referrer'
          && resource.data.get('partnerId', '') == profile(labId).partnerId;
        // B2B billing mirrors the bill into the centre's wallet statement.
        allow create: if pmaster == 'walletTxns' && partnerMayBill(labId) && profile(labId).role == 'b2b'
          && request.resource.data.centreId == profile(labId).partnerId
          && request.resource.data.kind == 'debit' && request.resource.data.amount <= 0;
        // A B2B portal user may ask for a top-up. It stays pending (not counted in the balance) until
        // lab staff approve it from B2B Labs > Wallet history.
        allow create: if pmaster == 'walletTxns' && isPartner(labId) && profile(labId).role == 'b2b'
          && request.resource.data.centreId == profile(labId).partnerId
          && request.resource.data.kind == 'topup' && request.resource.data.status == 'pending'
          && request.resource.data.amount is int && request.resource.data.amount > 0
          && request.resource.data.by == request.auth.uid
          && request.resource.data.requestedByPartner == true;
      }

      // Which keys may write each shared master. A rate list is also written by the owners it is attached to
      // (a referrer, B2B centre... creates / reprices its own list). Not enforceable here: that rate-list
      // entries match the catalogue.
      function isMaster(m) {
        return m in ['referrers', 'hospitals', 'tpas', 'govPanels', 'marketingTeam', 'processingLabs', 'b2bCentres', 'collectionCentres',
          'corporateClients', 'rateLists', 'otherCharges', 'paymentModes', 'reportTemplates', 'worksheetTemplates', 'reasons',
          'collectors', 'phlebotomists', 'priceBatches'];
      }
      function masterPerms(m) {
        return m in ['referrers', 'hospitals', 'tpas', 'govPanels'] ? ['referrals.manage']
          : m == 'marketingTeam' ? ['marketing.manage']
          : m == 'processingLabs' ? ['outsource.edit']
          : m == 'b2bCentres' ? ['b2b.manage']
          : m == 'collectionCentres' ? ['centres.manage']
          : m == 'corporateClients' ? ['corporate.manage']
          : m == 'rateLists' ? ['ratelists.edit', 'referrals.manage', 'b2b.manage', 'centres.manage', 'corporate.manage', 'outsource.edit', 'catalogue.price']
          : m == 'priceBatches' ? ['catalogue.price', 'ratelists.edit']
          : m in ['reasons', 'paymentModes', 'otherCharges', 'worksheetTemplates'] ? ['settings.manage', 'labmgmt.manage']
          : m == 'reportTemplates' ? ['catalogue.edit', 'settings.manage', 'labprofile.edit', 'labmgmt.manage']
          : m in ['collectors', 'phlebotomists'] ? ['bookings.manage', 'referrals.manage']
          : [];
      }
      function masterUpdateOk(labId, m) {
        let a = changed();
        return permAny(labId, masterPerms(m))
          // soft delete / restore (removeMaster, restoreMaster)
          || (a.size() > 0 && a.hasOnly(['deleted', 'deletedAt', 'updatedAt']) && permAny(labId, ['catalogue.delete', 'settings.manage']))
          // pointing an owner (referrer, centre...) at a shared rate list
          || (a.size() > 0 && a.hasOnly(['rateListId', 'updatedAt']) && permAny(labId, ['ratelists.edit']))
          // PRO assignment from the marketing team page
          || (m == 'referrers' && a.size() > 0 && a.hasOnly(['proManagerId', 'updatedAt']) && permAny(labId, ['marketing.manage']));
      }
      match /{master}/{id} {
        allow read: if isMaster(master) && isStaff(labId);
        allow create: if isMaster(master) && permAny(labId, masterPerms(master));
        allow update: if isMaster(master) && masterUpdateOk(labId, master);
        allow delete: if isMaster(master) && (permAny(labId, masterPerms(master)) || permAny(labId, ['catalogue.delete']));
      }

      // Round 3 analysis: background export jobs (the server builds the CSV into Storage), outsource vendor
      // settlements, and finance custom tabs (own, or shared to roles).
      match /exportJobs/{id} {
        allow read: if hasRole(labId, ['labAdmin', 'admin', 'manager']);
        allow create: if hasRole(labId, ['labAdmin', 'admin', 'manager'])
          && request.resource.data.status == 'queued' && request.resource.data.requestedBy == request.auth.uid;
        allow update: if hasRole(labId, ['labAdmin', 'admin', 'manager'])
          && resource.data.status == 'failed' && request.resource.data.status == 'queued'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'retryCount']);
        allow delete: if isAdmin(labId);
      }
      match /outsourceSettlements/{id} {
        allow read: if hasRole(labId, ['labAdmin', 'admin', 'manager']);
        allow create: if permAny(labId, ['outsource.edit']) && request.resource.data.createdBy == request.auth.uid;
        allow update: if permAny(labId, ['outsource.edit'])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'paidAt', 'paidBy', 'paidByName', 'reference', 'notes']);
        allow delete: if false;
      }
      match /financeTabs/{id} {
        // Tab definitions hold no patient data; the app shows only own tabs and tabs shared to the viewer's role.
        allow read: if isStaff(labId);
        allow create: if hasRole(labId, ['labAdmin', 'admin', 'manager']) && request.resource.data.ownerId == request.auth.uid;
        allow update, delete: if isStaff(labId) && (resource.data.ownerId == request.auth.uid || isAdmin(labId));
      }

      // Branch-scoped working records added with the parity work (quotations,
      // partner wallets/invoices/notes, activity feed, support tickets).
      // B2B wallet rows: a bill debits the centre (any billing staff), a pending top-up request needs b2b.view,
      // and anything that adds money or decides a request (approved top-up, approval row, discount) needs b2b.manage.
      // A positive "debit" row is a refund / void / edit-bill mirror, so it needs the key of that action.
      function walletCreateOk(labId) {
        let n = request.resource.data;
        let k = n.get('kind', '');
        return k == 'debit'
          ? (n.get('amount', 0) <= 0 || permAny(labId, ['billing.refund', 'billing.edit', 'billing.void', 'b2b.manage']))
          : (k == 'topup' && n.get('status', '') == 'pending')
            ? permAny(labId, ['b2b.view', 'b2b.manage'])
            : permAny(labId, ['b2b.manage']);
      }
      function scopedCreateOk(labId, s) {
        return s == 'walletTxns' ? walletCreateOk(labId)
          : s == 'creditNotes' ? permAny(labId, ['b2b.manage'])
          : s == 'partnerInvoices' ? permAny(labId, [request.resource.data.get('kind', '') == 'corporate' ? 'corporate.manage' : 'b2b.manage'])
          : s == 'outsourceJobs' ? permAny(labId, ['outsource.view', 'outsource.edit'])
          : true;
      }
      function scopedUpdateOk(labId, s) {
        return s == 'partnerInvoices' ? permAny(labId, [resource.data.get('kind', '') == 'corporate' ? 'corporate.manage' : 'b2b.manage'])
          : s == 'outsourceJobs' ? permAny(labId, ['outsource.view', 'outsource.edit'])
          : true;
      }
      match /{scoped}/{id} {
        allow read: if scoped in ['quotations', 'walletTxns', 'partnerInvoices',
          'creditNotes', 'activity', 'supportTickets', 'bulkImports', 'shiftCloses', 'commissionSettlements', 'outsourceJobs']
          && readBranch(labId);
        allow create: if scoped in ['quotations', 'walletTxns', 'partnerInvoices',
          'creditNotes', 'activity', 'supportTickets', 'bulkImports', 'shiftCloses', 'commissionSettlements', 'outsourceJobs']
          && createBranch(labId)
          && scopedCreateOk(labId, scoped);
        allow update: if scoped in ['quotations', 'partnerInvoices', 'supportTickets', 'bulkImports', 'outsourceJobs']
          && updateBranch(labId)
          && scopedUpdateOk(labId, scoped);
        allow delete: if false;
        // A draft partner invoice can be deleted (its bills become invoiceable again); sent / paid ones cannot.
        allow delete: if scoped == 'partnerInvoices' && resource.data.status == 'draft'
          && readBranch(labId) && scopedUpdateOk(labId, scoped);

        // Quotation attachments: small data-URL documents (no Storage bucket).
        match /attachments/{attId} {
          allow read, create, delete: if isStaff(labId) && scoped == 'quotations';
          allow update: if false;
        }
      }

      match /patients/{id} {
        allow read, create, update: if isStaff(labId);
        allow delete: if false;
        // Portal users register their own patients (stamped with partnerId) and read only those.
        allow create: if partnerMayBill(labId) && request.resource.data.get('partnerId', '') == profile(labId).partnerId;
        allow read: if isPartner(labId) && resource.data.get('partnerId', '') == profile(labId).partnerId;

        // Uploaded documents: kept as-is; only admins may remove one.
        match /documents/{docId} {
          allow read, create: if isStaff(labId);
          allow update: if false;
          allow delete: if isAdmin(labId);
        }
      }

      // Per-user radiology macros: each user reads and manages only their own.
      match /userMacros/{id} {
        allow read: if isStaff(labId) && resource.data.ownerUid == request.auth.uid;
        allow create: if isStaff(labId) && request.resource.data.ownerUid == request.auth.uid;
        allow update: if isStaff(labId) && resource.data.ownerUid == request.auth.uid && request.resource.data.ownerUid == request.auth.uid;
        allow delete: if isStaff(labId) && resource.data.ownerUid == request.auth.uid;
      }

      // PCPNDT Form F (one per bill). The patient's e-signature arrives through a Cloud Function.
      match /formF/{orderId} {
        allow read, create, update: if isStaff(labId);
        allow delete: if false;
      }

      // Saved smart report copy (per bill): staff write it, a Cloud Function checks it is current before sending.
      match /smartReports/{orderId} {
        allow read, write: if isStaff(labId);
      }

      // Bill PIN: staff may read it to the patient; only Cloud Functions create it.
      match /orderSecrets/{orderId} {
        allow read: if isStaff(labId);
        allow write: if false;
      }

      match /orders/{orderId} {
        allow read: if readBranch(labId);
        allow create: if createBranch(labId) && orderCreateOk(labId);
        allow update: if updateBranch(labId) && orderUpdateOk(labId);
        // Portal: own partner's bills only; new bills must carry the partner's own id and a branch they may use.
        allow read: if partnerOwns(labId, resource.data);
        allow create: if partnerMayBill(labId) && partnerOwns(labId, request.resource.data)
          && partnerBranchOk(profile(labId), request.resource.data);
        // Bills are voided (deleted flag), never removed.
        allow delete: if false;

        // Ledger is append-only: no edits, no deletes.
        match /ledger/{entryId} {
          allow read: if orderBranchOk(labId, orderId);
          allow create: if orderBranchOk(labId, orderId) && ledgerCreateOk(labId, orderId);
          allow read: if partnerOrderOk(labId, orderId);
          allow update, delete: if false;
        }

        // Delivery log: server writes provider sends; staff may log manual
        // WhatsApp / hard-copy handovers. Entries are never edited.
        match /deliveries/{id} {
          allow read: if orderBranchOk(labId, orderId) || partnerOrderOk(labId, orderId);
          allow create: if orderBranchOk(labId, orderId)
            && request.resource.data.channel in ['manualWhatsapp', 'hardcopy'];
          allow update, delete: if false;
        }

        // Report versions (signature snapshot, amendments): written by Cloud Functions only.
        match /reportVersions/{versionId} {
          allow read: if orderBranchOk(labId, orderId) || partnerOrderOk(labId, orderId);
          allow write: if false;
        }

        // Stored report snapshots (HTML + sha256 per approved version): Cloud Functions only.
        match /reportSnapshots/{snapId} {
          allow read: if orderBranchOk(labId, orderId);
          allow write: if false;
        }

        // Re-uploaded PDF replacing the generated report.
        match /reportFiles/{fileId} {
          allow read: if orderBranchOk(labId, orderId) || partnerOrderOk(labId, orderId);
          allow write: if orderBranchOk(labId, orderId);
        }

        match /results/{testId} {
          allow read: if orderBranchOk(labId, orderId) || partnerOrderOk(labId, orderId);
          allow create: if orderBranchOk(labId, orderId) && resultCreateOk(labId);
          allow update: if orderBranchOk(labId, orderId) && resultUpdateOk(labId);
          allow delete: if orderBranchOk(labId, orderId) && permAny(labId, ['results.amend']);

          match /versions/{versionId} {
            allow read: if orderBranchOk(labId, orderId);
            allow create: if orderBranchOk(labId, orderId)
              && permAny(labId, ['results.enter', 'results.approve', 'results.unapprove', 'results.amend']);
            allow update, delete: if false;
          }
        }
      }
    }
  }
}
